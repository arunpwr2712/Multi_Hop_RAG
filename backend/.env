# Multi-Hop Causal RAG environment configuration
# Ollama local model configuration.

# Ollama LLM
MHC_RAG_LLM_MODEL=llama3:latest
MHC_RAG_LLM_BASE_URL=http://localhost:11434
MHC_RAG_REQUIRE_OLLAMA=true
MHC_RAG_TEMPERATURE=0.1
MHC_RAG_TIMEOUT=180

# Retrieval / FAISS
MHC_RAG_FAISS_INDEX_PATH=faiss_index_512/index.faiss
MHC_RAG_FAISS_DOCSTORE_PATH=faiss_index_512/index.pkl
MHC_RAG_PERSIST_FAISS=true
MHC_RAG_SYNC_NEW_DOCS_ON_STARTUP=false
